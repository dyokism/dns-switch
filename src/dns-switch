#!/usr/bin/env bash
set -euo pipefail

check_deps() {
  local missing=()
  for cmd in resolvectl awk sed grep mktemp sort head timeout tput ip; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Error: Missing required dependencies: ${missing[*]}" >&2
    exit 1
  fi

  if ! systemctl is-active --quiet systemd-resolved 2>/dev/null; then
    echo "Error: systemd-resolved service is not running." >&2
    echo "Enable and start it via: sudo systemctl enable --now systemd-resolved" >&2
    exit 1
  fi

  local resolv_target
  resolv_target=$(readlink -f /etc/resolv.conf 2>/dev/null || true)
  if [[ -n "$resolv_target" && "$resolv_target" != *"/systemd/resolve/"* ]]; then
    echo "Warning: /etc/resolv.conf does not point to systemd-resolved stub resolver." >&2
    echo "Applications may bypass DoT until linked: sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf" >&2
  fi
}
check_deps

VERSION="1.0.0"

REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6 2>/dev/null || echo "$HOME")

CONFIG_DIR="$REAL_HOME/.config/dns-switch"
PROVIDERS_FILE="$CONFIG_DIR/providers.conf"
STATE_FILE="$CONFIG_DIR/state"

declare -A PROVIDERS
declare -a PROVIDER_ORDER

_sudo() {
  if [[ "$EUID" -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "Error: Root privileges required for '$1' but 'sudo' is not installed." >&2
    exit 1
  fi
}

load_providers() {
  [[ -f "$PROVIDERS_FILE" ]] || { echo "Error: Missing $PROVIDERS_FILE" >&2; exit 1; }
  while IFS='=' read -r name ips || [[ -n "$name" ]]; do
    name="${name%$'\r'}"
    ips="${ips%$'\r'}"
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    ips="${ips#"${ips%%[![:space:]]*}"}"
    ips="${ips%"${ips##*[![:space:]]}"}"
    [[ -z "$name" || "$name" == \#* ]] && continue
    PROVIDERS["$name"]="$ips"
    PROVIDER_ORDER+=("$name")
  done < "$PROVIDERS_FILE"
}

get_links() {
  local links=()
  while read -r l; do
    [[ -n "$l" ]] && links+=("$l")
  done < <(resolvectl status 2>/dev/null | awk '
    /^Link [0-9]/ { iface=$2; match($0, /\(([^)]+)\)/, m); name=m[1] }
    /Default Route: yes/ && name !~ /^(lo|docker|virbr|veth|br-|tailscale|wg|tun|tap)/ { print iface }
  ')

  if [[ ${#links[@]} -eq 0 ]]; then
    while read -r dev; do
      [[ -n "$dev" ]] && links+=("$dev")
    done < <(ip -o route show default 2>/dev/null | awk '{print $5}' | sort -u)
  fi

  if [[ ${#links[@]} -eq 0 ]]; then
    while read -r l; do
      [[ -n "$l" ]] && links+=("$l")
    done < <(resolvectl status 2>/dev/null | awk '
      /^Link [0-9]/ {
        iface=$2; match($0, /\(([^)]+)\)/, m); name=m[1]
        if (name !~ /^(lo|docker|virbr|veth|br-|tailscale|wg|tun|tap)/) print iface
      }
    ')
  fi

  echo "${links[@]}"
}

ensure_sudo() {
  if [[ "$EUID" -eq 0 ]]; then return 0; fi
  if command -v sudo >/dev/null 2>&1; then
    local res_bin
    res_bin=$(command -v resolvectl || echo "/usr/bin/resolvectl")
    if ! sudo -n "$res_bin" --version &>/dev/null; then
      sudo -v || true
    fi
  fi
}

apply() {
  local name="$1"
  local ip_arr=()
  IFS=',' read -ra raw_ips <<< "${PROVIDERS[$name]}"
  for ip in "${raw_ips[@]}"; do
    ip="${ip#"${ip%%[![:space:]]*}"}"
    ip="${ip%"${ip##*[![:space:]]}"}"
    [[ -n "$ip" ]] && ip_arr+=("$ip")
  done
  local links
  links=$(get_links)
  
  if [[ -z "$links" ]]; then
    echo "Error: No active network links found by resolvectl." >&2
    return 1
  fi
  
  ensure_sudo

  for link in $links; do
    _sudo resolvectl dns "$link" "${ip_arr[@]}" || return 1
    _sudo resolvectl domain "$link" ~. || return 1
    _sudo resolvectl dnsovertls "$link" yes || return 1
    _sudo resolvectl dnssec "$link" allow-downgrade || return 1
  done
  
  _sudo resolvectl flush-caches || true
}

verify() {
  timeout 3 resolvectl query example.com &>/dev/null
}

revert_all() {
  local links
  links=$(get_links)

  [[ -n "$links" ]] && ensure_sudo

  for link in $links; do
    _sudo resolvectl revert "$link" 2>/dev/null || true
    _sudo resolvectl dnsovertls "$link" no 2>/dev/null || true
    _sudo resolvectl dnssec "$link" no 2>/dev/null || true
  done
  
  _sudo resolvectl flush-caches || true
}

save_state() {
  mkdir -p "$CONFIG_DIR"
  echo "$1" > "$STATE_FILE"
  if [[ "$EUID" -eq 0 && -n "${SUDO_USER:-}" ]]; then
    chown "$REAL_USER:" "$STATE_FILE" 2>/dev/null || true
  fi
}

get_millis() {
  local ms
  ms=$(date +%s%3N 2>/dev/null || true)
  if [[ "$ms" =~ ^[0-9]+$ ]]; then
    echo "$ms"
  else
    echo "$(( $(date +%s) * 1000 ))"
  fi
}

tcp_probe() {
  local ip="$1"
  local port="${2:-853}"
  local start end lat
  
  ip="${ip%%#*}"
  ip="${ip#[}"
  ip="${ip%]}"

  start=$(get_millis)
  local success=1
  if timeout 2 bash -c "echo > /dev/tcp/$ip/$port" 2>/dev/null; then
    success=0
  elif command -v nc >/dev/null 2>&1; then
    if timeout 2 nc -z -w 2 "$ip" "$port" 2>/dev/null; then
      success=0
    fi
  fi

  if [[ $success -eq 0 ]]; then
    end=$(get_millis)
    lat=$((end - start))
    echo "$lat"
  else
    echo "9999"
  fi
}

run_probe() {
  [[ ${#PROVIDER_ORDER[@]} -gt 0 ]] || return 0
  local temp_dir
  temp_dir=$(mktemp -d)
  
  for name in "${PROVIDER_ORDER[@]}"; do
    local targets="${PROVIDERS[$name]}"
    (
      local best_lat="9999"
      IFS=',' read -ra ips <<< "$targets"
      for target in "${ips[@]}"; do
        target="${target#"${target%%[![:space:]]*}"}"
        target="${target%"${target##*[![:space:]]}"}"
        [[ -z "$target" ]] && continue
        local lat
        lat=$(tcp_probe "$target")
        if [[ "$lat" != "9999" ]]; then
          best_lat="$lat"
          break
        fi
      done
      echo "$best_lat:$name" > "$temp_dir/$name"
    ) &
  done
  
  wait
  
  if compgen -G "$temp_dir/*" > /dev/null; then
    cat "$temp_dir"/* | sort -t: -k1 -n
  fi
  rm -rf "$temp_dir"
}

bench_cmd() {
  if [[ ${#PROVIDER_ORDER[@]} -eq 0 ]]; then
    echo "No DNS providers configured in $PROVIDERS_FILE" >&2
    return 1
  fi
  echo "Benchmarking DoT providers (TCP port 853)..."
  echo ""
  local sorted
  sorted=$(run_probe)

  local rank=1
  while IFS=':' read -r lat name; do
    [[ -z "$name" ]] && continue
    if [[ "$lat" != "9999" ]]; then
      printf "  %2d. %-18s %5d ms\n" "$rank" "$name" "$lat"
    else
      printf "  %2d. %-18s timeout\n" "$rank" "$name"
    fi
    ((rank++))
  done <<< "$sorted"
}

auto_cmd() {
  if [[ ${#PROVIDER_ORDER[@]} -eq 0 ]]; then
    echo "No DNS providers configured in $PROVIDERS_FILE" >&2
    return 1
  fi
  echo "Probing providers for lowest TCP latency..."
  local sorted
  sorted=$(run_probe)
  
  local fastest_line
  fastest_line=$(echo "$sorted" | head -n 1)
  
  local lat="${fastest_line%%:*}"
  local name="${fastest_line#*:}"
  
  if [[ "$lat" == "9999" || -z "$name" ]]; then
    echo "Error: All providers timed out. Reverting to default." >&2
    switch_dns default
    return
  fi

  echo "Fastest provider: $name (${lat}ms)"
  switch_dns "$name"
}

switch_dns() {
  local target="$1"

  if [[ "$target" == "default" ]]; then
    printf "Reverting to router DNS... "
    revert_all
    rm -f "$STATE_FILE"
    echo "done"
    echo "Switched to default (router DNS)"
    return
  fi

  [[ -v "PROVIDERS[$target]" ]] || { echo "Error: Unknown provider '$target'" >&2; exit 1; }

  echo "Applying '$target' (DoT)..."
  if ! apply "$target"; then
    echo "Error: Failed to apply DNS settings for $target." >&2
    revert_all
    return 1
  fi

  printf "Verifying resolution... "
  if verify; then
    save_state "$target"
    echo "ok"
    echo "Switched to $target"
    return
  fi

  echo "failed"
  echo "Error: $target failed verification. Reverting to default router DNS..." >&2
  revert_all
  rm -f "$STATE_FILE"
}

status_cmd() {
  local current="default"
  [[ -f "$STATE_FILE" ]] && current=$(cat "$STATE_FILE")
  
  printf "%-10s: %s\n" "Provider" "$current"
  
  local query_out=""
  local is_ok=0
  local is_encrypted=0
  local is_auth=0

  if query_out=$(timeout 3 resolvectl query example.com 2>&1); then
    is_ok=1
    echo "$query_out" | grep -qi "encrypted transport: yes" && is_encrypted=1
    echo "$query_out" | grep -qi "authenticated: yes" && is_auth=1
  fi

  if [[ $is_ok -eq 1 ]]; then
    printf "%-10s: resolving\n" "Status"
  else
    printf "%-10s: failed\n" "Status"
  fi

  if [[ "$current" == "default" ]]; then
    printf "%-10s: router / DHCP\n" "Mode"
  else
    if [[ $is_encrypted -eq 1 ]]; then
      printf "%-10s: enforced (tls:853)\n" "DoT"
    else
      printf "%-10s: unencrypted\n" "DoT"
    fi

    if [[ $is_auth -eq 1 ]]; then
      printf "%-10s: validated\n" "DNSSEC"
    else
      printf "%-10s: unvalidated\n" "DNSSEC"
    fi
  fi

  echo ""
  
  resolvectl dns 2>/dev/null | grep -E '^Link' | while read -r line; do
    local iface
    iface=$(echo "$line" | sed -E 's/Link [0-9]+ \(([^)]+)\):.*/\1/')
    local ips
    ips=$(echo "$line" | awk -F': ' '{print $2}')
    
    printf "  %-8s: %s\n" "$iface" "${ips:-None}"
  done
}

install_cmd() {
  echo "Installing dns-switch system hooks..."
  
  echo "-> Configuring passwordless sudo for resolvectl"
  local res_bin
  res_bin=$(command -v resolvectl || echo "/usr/bin/resolvectl")
  local sudoers_file="/etc/sudoers.d/10-resolvectl"
  local tmp_sudoers
  tmp_sudoers=$(mktemp)
  echo "$REAL_USER ALL=(root) NOPASSWD: $res_bin" > "$tmp_sudoers"
  if command -v visudo >/dev/null 2>&1; then
    if ! visudo -cf "$tmp_sudoers" >/dev/null 2>&1; then
      echo "Error: Generated sudoers rule failed visudo validation." >&2
      rm -f "$tmp_sudoers"
      return 1
    fi
  fi
  _sudo install -m 0440 -o root -g root "$tmp_sudoers" "$sudoers_file"
  rm -f "$tmp_sudoers"

  echo "-> Configuring NetworkManager dispatcher"
  local nm_dir="/etc/NetworkManager/dispatcher.d"
  if [[ -d "/etc/NetworkManager" ]]; then
    local nm_file="$nm_dir/50-dns-switch"
    _sudo mkdir -p "$nm_dir"
    cat << 'NM_EOF' | _sudo tee "$nm_file" >/dev/null
#!/usr/bin/env bash
# Managed by dns-switch
STATE_FILE="__HOME__/.config/dns-switch/state"
PROVIDERS_FILE="__HOME__/.config/dns-switch/providers.conf"

case "$2" in
  up|vpn-up|dns-change) ;;
  *) exit 0 ;;
esac

[ -f "$STATE_FILE" ] || exit 0

CHOICE=$(cat "$STATE_FILE")
if [ -z "$CHOICE" ] || [ "$CHOICE" = "default" ]; then
  __RES_BIN__ status 2>/dev/null | awk '
    /^Link [0-9]/ { iface=$2; match($0, /\(([^)]+)\)/, m); name=m[1] }
    /Default Route: yes/ && name !~ /^(lo|docker|virbr|veth|br-|tailscale|wg|tun|tap)/ { print iface }
  ' | while read -r link; do
    __RES_BIN__ revert "$link" 2>/dev/null || true
    __RES_BIN__ dnsovertls "$link" no 2>/dev/null || true
    __RES_BIN__ dnssec "$link" no 2>/dev/null || true
  done
  exit 0
fi
[ -f "$PROVIDERS_FILE" ] || exit 0

IPS=""
while IFS='=' read -r name ips || [ -n "$name" ]; do
  [ "$name" = "$CHOICE" ] && { IPS="$ips"; break; }
done < "$PROVIDERS_FILE"
[ -z "$IPS" ] && exit 0

IFS=',' read -ra IP_ARR <<< "$IPS"

__RES_BIN__ status 2>/dev/null | awk '
  /^Link [0-9]/ { iface=$2; match($0, /\(([^)]+)\)/, m); name=m[1] }
  /Default Route: yes/ && name !~ /^(lo|docker|virbr|veth|br-|tailscale|wg|tun|tap)/ { print iface }
' | while read -r link; do
  __RES_BIN__ dns "$link" "${IP_ARR[@]}"
  __RES_BIN__ domain "$link" ~.
  __RES_BIN__ dnsovertls "$link" yes
  __RES_BIN__ dnssec "$link" allow-downgrade
done
NM_EOF
    _sudo sed -i "s|__HOME__|$REAL_HOME|g" "$nm_file"
    _sudo sed -i "s|__RES_BIN__|$res_bin|g" "$nm_file"
    _sudo chmod +x "$nm_file"
  else
    echo "-> NetworkManager not detected, skipping dispatcher hook."
  fi

  echo "-> Configuring systemd-resolved (DNSOverTLS=opportunistic)"
  local res_dir="/etc/systemd/resolved.conf.d"
  local res_file="$res_dir/50-dns-switch.conf"
  _sudo mkdir -p "$res_dir"
  printf "[Resolve]\nDNSOverTLS=opportunistic\n" | _sudo tee "$res_file" >/dev/null
  _sudo systemctl restart systemd-resolved || true

  local resolv_target
  resolv_target=$(readlink -f /etc/resolv.conf 2>/dev/null || true)
  if [[ "$resolv_target" != *"/systemd/resolve/"* ]]; then
    echo "-> Linking /etc/resolv.conf to systemd-resolved stub resolver"
    _sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf || true
  fi

  echo "Install complete."
}

uninstall_cmd() {
  echo "Reverting DNS settings..."
  revert_all
  rm -f "$STATE_FILE"

  echo "Removing dns-switch system hooks..."
  _sudo rm -f "/etc/sudoers.d/10-resolvectl"
  _sudo rm -f "/etc/NetworkManager/dispatcher.d/50-dns-switch"
  _sudo rm -f "/etc/systemd/resolved.conf.d/50-dns-switch.conf"
  _sudo systemctl restart systemd-resolved || true
  echo "Uninstall complete."
}

tui_select() {
  local options=("$@")
  local current_idx=0
  local current_active="default"
  declare -A lat_map=()
  local probed=0
  
  [[ -f "$STATE_FILE" ]] && current_active=$(cat "$STATE_FILE")

  for i in "${!options[@]}"; do
    if [[ "${options[$i]}" == "$current_active" ]]; then
      current_idx=$i
      break
    fi
  done

  tput civis 2>/dev/null || true
  cleanup() { tput cnorm 2>/dev/null || true; }
  trap cleanup EXIT INT TERM

  echo "Select a DNS provider:"
  echo "(up/down/jk to navigate, enter to select, b to bench, q to cancel)"
  echo ""

  local key
  while true; do
    for i in "${!options[@]}"; do
      local opt="${options[$i]}"
      local display="$opt"

      if [[ "$opt" == "$current_active" ]]; then
        display="$display (active)"
      fi

      local row_text
      if [[ $probed -eq 1 ]]; then
        local lat_info=""
        if [[ "$opt" == "default" ]]; then
          lat_info="--"
        elif [[ -n "${lat_map[$opt]:-}" && "${lat_map[$opt]}" != "9999" ]]; then
          lat_info="$(printf "%4d ms" "${lat_map[$opt]}")"
        else
          lat_info="timeout"
        fi
        row_text="$(printf "%-26s %s" "$display" "$lat_info")"
      else
        row_text="$display"
      fi

      if [[ $i -eq $current_idx ]]; then
        echo -e "> \e[1;36m$row_text\e[0m"
      else
        echo "  $row_text"
      fi
    done

    read -rsn1 key || break
    case "$key" in
      $'\x1b')
        read -rsn2 -t 0.05 seq || seq=""
        case "$seq" in
          '[A') current_idx=$((current_idx - 1));;
          '[B') current_idx=$((current_idx + 1));;
          '')
            tput cuu $((${#options[@]} + 3)) 2>/dev/null || true
            tput ed 2>/dev/null || true
            tput cnorm 2>/dev/null || true
            trap - EXIT INT TERM
            echo "Cancelled."
            return 0
            ;;
          *)
            while read -rsn1 -t 0.01 discard; do :; done
            ;;
        esac
        ;;
      k|K) current_idx=$((current_idx - 1));;
      j|J) current_idx=$((current_idx + 1));;
      b|B)
        tput cuu ${#options[@]} 2>/dev/null || true
        tput ed 2>/dev/null || true
        printf "  \e[2mProbing latency...\e[0m\n"
        local sorted
        sorted=$(run_probe)
        while IFS=':' read -r l n; do
          [[ -n "$n" ]] && lat_map["$n"]="$l"
        done <<< "$sorted"
        probed=1
        tput cuu 1 2>/dev/null || true
        tput ed 2>/dev/null || true
        continue
        ;;
      "") 
        tput cuu $((${#options[@]} + 3)) 2>/dev/null || true
        tput ed 2>/dev/null || true
        tput cnorm 2>/dev/null || true
        trap - EXIT INT TERM
        switch_dns "${options[$current_idx]}"
        return 0
        ;;
      q|Q)
        tput cuu $((${#options[@]} + 3)) 2>/dev/null || true
        tput ed 2>/dev/null || true
        tput cnorm 2>/dev/null || true
        trap - EXIT INT TERM
        echo "Cancelled."
        return 0
        ;;
    esac

    if [[ $current_idx -lt 0 ]]; then current_idx=$((${#options[@]} - 1)); fi
    if [[ $current_idx -ge ${#options[@]} ]]; then current_idx=0; fi

    tput cuu ${#options[@]} 2>/dev/null || true
    tput ed 2>/dev/null || true
  done
}

help_cmd() {
  cat <<'HELP_EOF'
dns-switch: Manage systemd-resolved DNS over TLS (DoT) + DNSSEC

Usage:
  dns-switch [command|provider]

Commands:
  (default)           Open interactive TUI picker
  <provider>          Switch to specific provider (e.g. cloudflare, quad9)
  auto                Benchmark and select fastest provider
  bench               Benchmark TCP latency across all providers
  status              Show active provider and resolution status
  default             Revert to router / DHCP DNS

System Hooks:
  install             Configure system hooks (sudo)
  uninstall           Remove system hooks (sudo)

Flags:
  -h, --help          Show this help message
  -v, --version       Show version
HELP_EOF
}

case "${1:-}" in
  version|--version|-v)
    echo "dns-switch v$VERSION"
    ;;
  help|-h|--help)
    help_cmd
    ;;
  status)
    load_providers 2>/dev/null || true
    status_cmd
    ;;
  bench)
    load_providers
    bench_cmd
    ;;
  auto)
    load_providers
    auto_cmd
    ;;
  install)
    install_cmd
    ;;
  uninstall)
    uninstall_cmd
    ;;
  default)
    switch_dns default
    ;;
  "")
    if [[ ! -t 0 ]]; then
      status_cmd
      exit 0
    fi
    load_providers
    opts=("${PROVIDER_ORDER[@]}" "default")
    tui_select "${opts[@]}"
    ;;
  *)
    load_providers
    switch_dns "$1"
    ;;
esac
